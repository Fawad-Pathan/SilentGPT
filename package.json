{
  "name": "silentgpt",
  "version": "1.00.0",
  "description": "SilentGPT — AI Screen Overlay",
  "main": "src/main.js",
  "author": {
    "name": "SilentGPT",
    "email": "support@trysilentgpt.net"
  },
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0",
    "stripe": "^20.3.1",
    "tweetnacl": "^1.0.3"
  },
  "optionalDependencies": {
    "ffi-napi": "^4.0.3",
    "ref-napi": "^3.0.3"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "net.trysilentgpt.app",
    "productName": "SilentGPT",
    "artifactName": "SilentGPT.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
