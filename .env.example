# SilentGPT local runtime configuration
# Copy this file to .env and fill in your own keys. Never commit .env.

# Required for answer/simple/translate/solve/essay/code/email/flashcards/autopilot modes.
SILENTGPT_OPENAI_API_KEY=sk-proj-your_openai_key_here

# Optional: used for Research mode.
SILENTGPT_PERPLEXITY_API_KEY=pplx-your_perplexity_key_here

# Optional: Stripe checkout/subscription configuration.
SILENTGPT_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
SILENTGPT_STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id
SILENTGPT_STRIPE_ANNUAL_PRICE_ID=price_your_annual_price_id
SILENTGPT_STRIPE_SUCCESS_URL=https://trysilentgpt.net/checkout/success?session_id={CHECKOUT_SESSION_ID}
SILENTGPT_STRIPE_CANCEL_URL=https://trysilentgpt.net/checkout/cancel
SILENTGPT_STRIPE_BILLING_PORTAL_RETURN_URL=https://trysilentgpt.net/account

# Optional: GitHub token for support ticket creation.
SILENTGPT_GITHUB_SUPPORT_TOKEN=github_pat_your_support_token_here
